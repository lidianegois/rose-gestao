# Copie para .env (ou defina no painel do Render). Nenhuma é obrigatória para testar localmente.

# Endereço do PostgreSQL. Sem ele, os dados ficam no arquivo data/banco-local.json (só para testes).
DATABASE_URL=postgres://usuario:senha@host:5432/rose

# Use "true" se o banco exigir SSL (por exemplo, ao usar o endereço externo do Render a partir do seu computador).
PGSSL=false

# Usuário e senha para entrar no site. Sem APP_PASSWORD, qualquer pessoa com o link acessa os dados.
APP_USER=rose
APP_PASSWORD=troque-esta-senha

# Porta local (o Render define a dele sozinho).
PORT=3000
